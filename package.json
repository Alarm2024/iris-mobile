{
  "name": "iris-desk-voice",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "native:android": "expo prebuild --platform android --clean",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "bundle:check": "expo export --platform android --output-dir dist-check"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.14",
    "@react-navigation/native-stack": "^6.9.22",
    "@solana-mobile/mobile-wallet-adapter-protocol": "2.2.2",
    "@solana-mobile/mobile-wallet-adapter-protocol-web3js": "2.2.2",
    "@solana/web3.js": "^1.98.0",
    "@tanstack/react-query": "^5.24.1",
    "buffer": "^6.0.3",
    "expo": "~52.0.43",
    "expo-asset": "~11.0.5",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.8",
    "expo-crypto": "~14.0.2",
    "expo-font": "~13.0.4",
    "expo-speech": "~13.0.1",
    "expo-speech-recognition": "1.1.1",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.9",
    "js-base64": "^3.7.7",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-paper": "^5.12.3",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "29.5.14",
    "@types/react": "~18.3.12",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.6",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|react-native-paper|@solana/.*|@solana-mobile/.*)"
    ]
  }
}
